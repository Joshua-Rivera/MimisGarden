# Development: uvicorn app.main:app --env-file .env.local
ADMIN_TOKEN=replace-with-a-long-random-token
# Optional. Defaults are absolute paths inside backend/storage and app/ml/models.
# STORAGE_DIR=/absolute/path/to/persistent/storage
# MODEL_PATH=/absolute/path/to/plant_model_v1.pt
# DATABASE_URL=sqlite:////absolute/path/to/planthealth.db
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

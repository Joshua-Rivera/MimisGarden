#ignore local environment
*backend/.backend
*backend/.venv
#ignore compiled python files
__pycache__/
*.pyc
*mockups
node_modules/

# Local ML datasets and generated dataset splits
backend/app/ml/data/
backend/app/ml/raw/
backend/app/ml/ml_data/
backend/ml/

# Generated ML model checkpoints (store these outside regular Git or use Git LFS)
backend/app/ml/models/*.pt
backend/app/ml/models/*.pth

# Keep project-local Codex skills available without publishing them.
.codex/skills/
# Python
backend/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
# Environment variables
backend/.env
frontend/.env
# Databases
*.db
*.sqlite
*.sqlite3
# Uploaded files and models
backend/storage/uploaded_images/*
!backend/storage/uploaded_images/.gitkeep
backend/storage/models/*
!backend/storage/models/.gitkeep
# Frontend
frontend/node_modules/
frontend/dist/
# macOS
.DS_Store
#ignore part of setup
setup/ml_system_benchmark
setup/native_ml_preflight
backend/app/ml/datasets
backend/app/ml/manifests
backend/app/ml/preprocessing